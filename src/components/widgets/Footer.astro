  <div class="dark:bg-dark absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div
    class="relative mx-auto flex max-w-7xl flex-col gap-4 px-4 py-8 text-sm text-muted dark:text-slate-300 sm:flex-row sm:items-end sm:justify-between sm:px-6"
  >
    <div>
      <p class="text-base font-bold text-primary dark:text-white">TATAR Lab</p>
      <p class="mt-1">Department of Cybersecurity, University at Albany, SUNY</p>
    </div>
    <p>© {year}</p>
  </div>
</footer>
