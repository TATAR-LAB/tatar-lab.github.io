---
import Image from '~/components/common/Image.astro';
---

<span class="flex items-center gap-3">
  <Image width={40} height={40} src="~/assets/images/logo.png" alt="TATAR Lab logo" loading="eager" />
  <span class="flex flex-col gap-1 leading-none">
    <span class="whitespace-nowrap text-lg font-semibold text-primary dark:text-white">TATAR Lab</span>
    <span class="hidden text-xs text-muted lg:block">University at Albany</span>
  </span>
</span>
