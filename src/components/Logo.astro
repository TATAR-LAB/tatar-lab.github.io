---
import Image from '~/components/common/Image.astro';
---

<span class="flex items-center gap-2.5">
  <Image width={48} height={48} src="~/assets/images/logo.png" alt="TATAR Lab logo" loading="eager" />
  <span class="flex flex-col leading-none">
    <span class="text-xl font-extrabold tracking-tight text-primary dark:text-white">TATAR Lab</span>
    <span class="hidden text-[0.72rem] font-medium uppercase tracking-[0.14em] text-muted sm:block">
      University at Albany
    </span>
  </span>
</span>
