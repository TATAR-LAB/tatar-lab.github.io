---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';

import Stats from '~/components/widgets/Stats.astro';
import Image from '~/components/common/Image.astro';
import viceroyLogo from '~/assets/images/viceroy-logo.webp';
import catisLogo from '~/assets/images/catis-logo.webp';

const metadata = {
  title: 'TATAR Lab · AI Security, Cyber Risk and Critical Infrastructure',
  ignoreTitleTemplate: true,
};

// Shared card treatment: white panel, hairline border, navy icon chip, left aligned.
const cardClasses = {
  items: {
    panel:
      'flex-col h-full max-w-none rounded-xl border border-slate-200 bg-white p-6 text-center shadow-sm sm:text-left',
    icon: 'w-11 h-11 p-2.5 mb-4 mr-0 rtl:ml-0 rounded-lg bg-primary/5 text-primary ring-1 ring-primary/10',
    title: 'text-lg md:text-lg font-bold leading-snug tracking-tight sm:min-h-[3.25rem]',
    description: 'mt-2 text-[0.95rem] leading-relaxed text-muted',
  },
};

const initiatives = [
  {
    name: 'VICOR',
    title: 'Virtual Institute of Cyber Operations and Research',
    description:
      'A Department of Defense funded cyber institute run with Florida International University. VICOR builds the operational skills of future cyber leaders through applied training, competitions, internships, and research placements.',
    image: viceroyLogo.src,
    href: 'https://cyberresearchgroup.org/',
    label: 'cyberresearchgroup.org',
  },
  {
    name: 'CATIS',
    title: 'Cyber and Terrorism Insurance Studies',
    description:
      'A national, NSF supported center on catastrophic cyber and terrorism risk, anchored at the University at Albany with the University of Michigan. CATIS spans risk modeling, insurance and capital markets, security controls, systemic AI risk, and policy.',
    image: catisLogo.src,
    href: 'https://catis.org',
    label: 'catis.org',
  },
];
---

<Layout metadata={metadata}>
  <!-- Hero ******************* -->
  <Hero>
    <Fragment slot="title">
      <span class="block text-slate-900">TATAR Lab</span>
      <span class="mt-2 block text-2xl font-bold tracking-tight text-primary sm:text-3xl md:text-4xl">
        Securing AI. Quantifying Cyber Risk.
      </span>
    </Fragment>

    <Fragment slot="subtitle">
      <p class="mx-auto max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">
        A research lab at the University at Albany, SUNY, working on the security and safety of AI systems, the
        economics of cyber risk, and the protection of critical infrastructure.
      </p>
    </Fragment>

    <Fragment slot="content">
      <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a class="btn-primary w-full sm:w-auto" href="#research">Explore our research</a>
        <a class="btn w-full sm:w-auto" href="#contact">Work with us</a>
      </div>

      <!-- <div class="mt-14 border-t border-slate-200 pt-10">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted">Part of</p>
        <div class="mt-6 flex justify-center">
          <a href="https://www.albany.edu/cehc" target="_blank" rel="noopener noreferrer">
            <Image
              class="h-32 w-auto sm:h-40 lg:h-44"
              src="~/assets/images/cehc.png"
              alt="College of Emergency Preparedness, Homeland Security and Cybersecurity, University at Albany, State University of New York"
              width={560}
              height={350}
              loading="eager"
            />
          </a>
        </div>
      </div> -->
    </Fragment>
  </Hero>

  <!-- Mission ******************* -->
  <Features
    id="mission"
    tagline="Our mission"
    title="Advancing security through research"
    subtitle="We combine risk analysis, economics, engineering, and policy to answer questions no single discipline can settle on its own."
    columns={3}
    classes={cardClasses}
    items={[
      {
        title: 'Measure what is actually risky',
        description:
          'We build benchmarks, datasets, and evaluation frameworks that turn vague claims about AI and cyber risk into numbers that can be compared and audited.',
        icon: 'tabler:ruler-measure',
      },
      {
        title: 'Follow risk through systems',
        description:
          'Risk rarely stays where it starts. We model how it propagates across model supply chains, insurance portfolios, and interconnected infrastructure.',
        icon: 'tabler:affiliate',
      },
      {
        title: 'Translate research into decisions',
        description:
          'Our work is aimed at the people who act on it: security teams, insurers, regulators, and boards. We put findings in the language each of them uses.',
        icon: 'tabler:target-arrow',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Features>

  <!-- Research Focus Areas ******************* -->
  <Features
    id="research"
    tagline="What we work on"
    title="Research focus areas"
    subtitle="Six threads run through the lab's current and past work. They overlap by design."
    columns={3}
    classes={cardClasses}
    items={[
      {
        title: 'AI Security & Autonomous Agents',
        description:
          'We study what AI agents can actually do in offensive and defensive security, measuring how far they get on realistic tasks and what closes the gap between a cheap model and a frontier one.',
        icon: 'tabler:robot',
      },
      {
        title: 'LLM Risk, Safety & Evaluation',
        description:
          'We develop structured ways to score the security posture of language models, working from established taxonomies and tracing how risk in a base model propagates to everything derived from it.',
        icon: 'tabler:shield-search',
      },
      {
        title: 'Cyber Insurance & Risk Transfer',
        description:
          'We study how to price cyber risk, how catastrophic exposures behave, and where policies written before AI leave coverage ambiguous.',
        icon: 'tabler:umbrella',
      },
      {
        title: 'Economics of Cybersecurity',
        description:
          'Security budgets are set under uncertainty and the incentives rarely point where the risk is. We apply risk analysis, operations research, and economics to investment and risk mitigation prioritization.',
        icon: 'tabler:chart-arrows',
      },
      {
        title: 'Critical Infrastructure',
        description:
          'Attacks on infrastructure do not stop at the system they hit. We model how disruptions cascade through interconnected sectors, including healthcare, industrial control, space, and maritime.',
        icon: 'tabler:building-broadcast-tower',
      },
      {
        title: 'AI Incidents & Governance',
        description:
          'Understanding how AI systems fail in the world requires a reliable record of those failures. We work on collecting that record and on evaluating the tooling meant to govern it.',
        icon: 'tabler:alert-triangle',
      },
    ]}
  />

  <!-- Flagship Initiatives ******************* -->
  <section id="initiatives" class="not-prose relative scroll-mt-[72px]">
    <div class="absolute inset-0 -z-[1] bg-slate-50 dark:bg-transparent" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-5xl px-4 py-12 text-default md:px-6 md:py-16 lg:py-20">
      <div class="mb-8 text-center md:mx-auto md:mb-12 md:max-w-3xl">
        <p class="text-base font-bold uppercase tracking-wide text-secondary">At scale</p>
        <h2 class="font-heading text-3xl font-bold leading-tight tracking-tighter md:text-4xl">Multi-institutional Initiatives</h2>
        <p class="mt-4 text-xl text-muted">
          Beyond individual projects, the lab helps lead two multi institution centers.
        </p>
      </div>

      <div class="grid gap-8 sm:grid-cols-2">
        {
          initiatives.map((item) => (
            <div class="flex h-full flex-col rounded-xl border border-slate-200 bg-white p-7 text-center shadow-sm sm:text-left">
              <div class="mx-auto mb-4 p-4">
                <img
                  class="mx-auto h-auto max-h-14 w-auto object-contain"
                  src={item.image}
                  alt={`${item.name} logo`}
                  loading="lazy"
                />
              </div>
              <p class="text-xs font-bold uppercase tracking-[0.16em] text-secondary">{item.name}</p>
              <h3 class="mt-1 text-xl sm:min-h-[3.5rem] font-bold leading-snug tracking-tight">{item.title}</h3>
              <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">{item.description}</p>
              <div class="mt-auto flex flex-wrap items-center justify-center gap-x-4 gap-y-2 pt-6 sm:justify-start">
                <a class="btn-primary px-5 py-2.5 text-sm" href={item.href} target="_blank" rel="noopener noreferrer">
                  Read more
                </a>
                <span class="text-sm text-muted">{item.label}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Impact ******************* -->
  <Steps
    tagline="Where the work lands"
    title="Research with a constituency"
    items={[
      {
        title: 'Government & defense',
        description:
          'Work supported by and conducted with NSF, the Department of Defense, the Air Force Research Laboratory, the Office of Naval Research, NSA, NIST, and NATO.',
        icon: 'tabler:building-castle',
      },
      {
        title: 'Industry & insurance',
        description:
          'Collaboration with insurers, actuarial bodies, and risk practitioners on cyber risk quantification, third party risk, and the coverage questions raised by AI.',
        icon: 'tabler:briefcase',
      },
      {
        title: 'Students & workforce',
        description:
          'Curricula, cyber exercises, competitions, and funded research placements that move students into real operational problems and into the cybersecurity workforce.',
        icon: 'tabler:users',
      },
      {
        title: 'Open research output',
        description:
          'Benchmarks, datasets, evaluation harnesses, and agent tooling released publicly so results can be reproduced, contested, and built on.',
        icon: 'tabler:brand-github',
      },
    ]}
  />

  <!-- Stats ******************* -->
  <!-- <Stats
    title="By the numbers"
    stats={[
      { title: 'Peer-reviewed publications', amount: '40+', icon: 'tabler:file-text' },
      { title: 'In grants & contracts', amount: '$4M+', icon: 'tabler:coin' },
      { title: 'Citations', amount: '1,000+', icon: 'tabler:quote' },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Stats> -->

  <!-- Team ******************* -->
  <section id="team" class="not-prose relative scroll-mt-[72px]">
    <div class="absolute inset-0 -z-[1] bg-slate-50 dark:bg-transparent" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-5xl px-4 py-12 text-default md:px-6 md:py-16 lg:py-20">
      <div class="mb-8 text-center md:mx-auto md:mb-12 md:max-w-3xl">
        <p class="text-base font-bold uppercase tracking-wide text-secondary">Who leads it</p>
        <h2 class="font-heading text-3xl font-bold leading-tight tracking-tighter md:text-4xl">Team</h2>
      </div>

      <!-- Director -->
      <div class="mb-16 flex flex-col gap-8 md:flex-row md:items-center md:gap-16">
        <div class="md:basis-1/2">
          <div class="relative m-auto max-w-md">
            <Image
              class="mx-auto w-full rounded-lg bg-gray-500 shadow-lg"
              src="~/assets/images/tatar.jpg"
              alt="Portrait of Dr. Unal Tatar"
              width={500}
              height={500}
              widths={[800, 1200]}
              sizes="(max-width: 768px) 100vw, 432px"
              layout="responsive"
              loading="lazy"
            />
          </div>
        </div>
        <div class="md:basis-1/2">
          <h3 class="mb-3 text-2xl font-bold tracking-tight dark:text-white sm:text-3xl">Dr. Unal Tatar</h3>
          <p class="text-lg leading-relaxed text-muted">
            Associate Professor in the Department of Cybersecurity at the University at Albany&rsquo;s College of Emergency
            Preparedness, Homeland Security and Cybersecurity. Before joining UAlbany he led Turkey&rsquo;s national
            Computer Emergency Response Team and advised NATO&rsquo;s Centre of Excellence for Defence Against Terrorism. He
            is the lead principal investigator of the DoD funded VICOR institute and directs the NSF supported CATIS center, 
            with grants and contracts, and has published two edited volumes and peer reviewed papers in venues including 
            <em>Risk Analysis</em> and <em>Computers &amp; Security</em>.
          </p>
          <div class="mt-4 flex flex-wrap gap-x-6 text-sm font-semibold text-primary">
            <a
              class="inline-block py-2.5 hover:underline"
              href="https://www.albany.edu/cehc/faculty/unal-tatar"
              target="_blank"
              rel="noopener noreferrer"
            >
              Faculty profile
            </a>
            <a
              class="inline-block py-2.5 hover:underline"
              href="https://scholar.google.com/citations?user=3agv4kcAAAAJ&hl=en"
              target="_blank"
              rel="noopener noreferrer"
            >
              Google Scholar
            </a>
          </div>
        </div>
      </div>

      <!-- Team Members -->
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        <!-- Graduate Students -->
        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <h4 class="mb-4 text-sm font-bold uppercase tracking-wide text-secondary">Graduate Students</h4>
          <ul class="space-y-3">
            <li class="text-lg font-semibold text-default">Hakan T. Otal</li>
            <li class="text-lg font-semibold text-default">Brianna L. Bace</li>
            <li class="text-lg font-semibold text-default">Divij Jain</li>
          </ul>
        </div>

        <!-- Undergraduate Students -->
        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <h4 class="mb-4 text-sm font-bold uppercase tracking-wide text-secondary">Undergraduate Students</h4>
          <ul class="space-y-3">
            <li class="text-lg font-semibold text-default">Shayaan Khaliq</li>
            <li class="text-lg font-semibold text-default">Tyler H. Merves</li>
            <li class="text-lg font-semibold text-default">Joseph M. Escobar</li>
            <li class="text-lg font-semibold text-default">Michael H. Conaway</li>
          </ul>
        </div>

        <!-- Non-Resident Researchers -->
        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <h4 class="mb-4 text-sm font-bold uppercase tracking-wide text-secondary">Non-Resident Researchers</h4>
          <ul class="space-y-3">
            <li class="text-lg font-semibold text-default">C. Cagri Akgunduz</li>
            <li class="text-lg font-semibold text-default">Thora Knight</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact ******************* -->
  <section id="contact" class="not-prose relative scroll-mt-[72px]">
    <div class="absolute inset-0 -z-[1] bg-slate-50 dark:bg-transparent" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-5xl px-6 py-12 text-default md:px-8 md:py-16 lg:py-20">
      <div class="grid items-center gap-10 md:grid-cols-2 md:gap-14">
        <div>
          <p class="text-base font-bold uppercase tracking-wide text-secondary">Contact</p>
          <h2 class="mt-2 font-heading text-3xl font-bold leading-tight tracking-tighter md:text-4xl">
            Work with the lab
          </h2>
          <p class="mt-4 text-lg text-muted">
            We are glad to hear from prospective graduate and undergraduate students, and from collaborators in
            government, industry, and insurance. A short note about what you are working on is the best place to start.
          </p>
          <a class="btn-primary mt-8 inline-flex" href="mailto:utatar@albany.edu">Get in touch</a>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-7 shadow-sm">
          <dl class="space-y-6">
            <div>
              <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-muted">Email</dt>
              <dd class="mt-1 text-lg">
                <a class="inline-block py-1 font-semibold text-primary hover:underline" href="mailto:utatar@albany.edu">
                  utatar@albany.edu
                </a>
              </dd>
            </div>
            <div>
              <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-muted">Visit</dt>
              <dd class="mt-1 text-base leading-relaxed">
                ETEC Building, Room 350P<br />
                1220 Washington Avenue<br />
                Albany, NY 12222
              </dd>
            </div>
            <div>
              <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-muted">Code &amp; data</dt>
              <dd class="mt-1 text-base">
                <a
                  class="inline-block py-1 font-semibold text-primary hover:underline"
                  href="https://github.com/TATAR-LAB"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  github.com/TATAR-LAB
                </a>
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>
</Layout>
