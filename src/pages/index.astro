---
import Layout from '~/layouts/PageLayout.astro';
import Section from '~/components/ui/Section.astro';
import Image from '~/components/common/Image.astro';
import viceroyLogo from '~/assets/images/viceroy-logo.webp';
import catisLogo from '~/assets/images/catis-logo.webp';
import nsfLogo from '~/assets/images/sponsors/nsf.webp';
import dodLogo from '~/assets/images/sponsors/dod.webp';
import afrlLogo from '~/assets/images/sponsors/afrl.webp';
import onrLogo from '~/assets/images/sponsors/onr.webp';
import nistLogo from '~/assets/images/sponsors/nist.webp';
import nsaLogo from '~/assets/images/sponsors/nsa.webp';
import natoLogo from '~/assets/images/sponsors/nato.webp';
import griffissLogo from '~/assets/images/sponsors/griffiss.webp';
import gfceLogo from '~/assets/images/sponsors/gfce.webp';
import soaLogo from '~/assets/images/sponsors/soa.webp';

const metadata = {
  title: 'TATAR Lab · Cyber Risk, AI Security, and Critical Infrastructure',
  ignoreTitleTemplate: true,
};

const mission = [
  {
    title: 'Quantify risk with evidence',
    description:
      'We build benchmarks, datasets, and evaluation frameworks that turn qualitative judgments about AI and cyber risk into measurements others can compare and audit.',
  },
  {
    title: 'Model systemic and cascading risk',
    description:
      'Risk rarely stays where it starts. We trace how it spreads across interconnected systems, insurance portfolios, and critical infrastructure.',
  },
  {
    title: 'Translate research into decisions',
    description:
      'We write for the people who act on our findings: security teams, insurers, regulators, and boards. Each of them gets results in the terms they already use.',
  },
  {
    title: 'Develop the cybersecurity workforce',
    description:
      'Managing these risks takes skilled people. Through VICOR and lab projects, students get hands-on experience in cyber operations, AI security, and risk analysis before starting careers in the field.',
  },
];

const research = [
  {
    title: 'Frontier AI & agentic security',
    description:
      'AI agents are starting to do real offensive and defensive security work. We red team frontier models and agents on realistic tasks to measure how far they get and what closes the gap between a low-cost model and a frontier one.',
  },
  {
    title: 'LLM risk, safety & evaluation',
    description:
      'Comparing language models on security needs a shared measure. We build adversarial evaluations and scoring on established taxonomies, and trace how risk in a base model carries into the models built from it.',
  },
  {
    title: 'Cyber & AI insurance',
    description:
      'Cyber risk is still hard to price. We study how catastrophic and systemic exposures behave and where policies written before AI leave coverage ambiguous.',
  },
  {
    title: 'Economics of cybersecurity',
    description:
      'Organizations set security budgets under uncertainty, and the incentives rarely point where the risk is. We apply risk analysis, operations research, and economics to prioritize security investment and risk mitigation.',
  },
  {
    title: 'Critical infrastructure',
    description:
      'Attacks on infrastructure do not stop at the system they hit. We model how disruptions cascade across healthcare, space, maritime, and other interconnected sectors, and study the new risks AI brings to industrial control systems.',
  },
  {
    title: 'AI governance, oversight & policy',
    description:
      'Governing AI starts with a reliable record of how it fails in the world. We build that record and evaluate the tools meant to govern AI. We also study how people keep oversight of autonomous systems, and work on the policy and national security questions that follow.',
  },
].map((item, i) => ({ ...item, number: String(i + 1).padStart(2, '0'), anchor: `research-${i + 1}` }));

const initiatives = [
  {
    name: 'VICOR',
    title: 'Virtual Institute of Cyber Operations and Research',
    description:
      'A multi-university cyber institute led by the University at Albany and funded by the Department of Defense. VICOR builds the operational skills of future cyber leaders through applied training, competitions, internships, and research placements.',
    image: viceroyLogo.src,
    logoClass: 'max-h-11',
    href: 'https://cyberresearchgroup.org/',
    label: 'cyberresearchgroup.org',
  },
  {
    name: 'CATIS',
    title: 'Cyber and Terrorism Insurance Studies',
    description:
      'A research center on cyber and terrorism insurance, led jointly by the University at Albany and the University of Michigan. It is in a planning phase funded by the NSF Industry-University Cooperative Research Centers program, which brings academic and industry partners together on catastrophic cyber and terrorism risk, insurance, and emerging technologies.',
    image: catisLogo.src,
    logoClass: 'max-h-14',
    href: 'https://catis.org',
    label: 'catis.org',
  },
];

const sponsors = [
  { name: 'National Science Foundation', image: nsfLogo.src },
  { name: 'Department of Defense', image: dodLogo.src },
  { name: 'Air Force Research Laboratory', image: afrlLogo.src },
  { name: 'Office of Naval Research', image: onrLogo.src },
  { name: 'National Institute of Standards and Technology', image: nistLogo.src },
  { name: 'National Security Agency', image: nsaLogo.src },
  { name: 'NATO Science for Peace and Security Programme', image: natoLogo.src },
  { name: 'Griffiss Institute', image: griffissLogo.src },
  { name: 'Global Forum on Cyber Expertise', image: gfceLogo.src },
  { name: 'Society of Actuaries', image: soaLogo.src },
];

const impact = [
  {
    title: 'Government & defense',
    description: 'Research supported by and conducted with NSF, DoD, AFRL, ONR, NSA, NIST, and NATO.',
  },
  {
    title: 'Industry & insurance',
    description:
      'Research projects for the Society of Actuaries and an NAIC research fellowship. We also work with insurers and risk practitioners on cyber risk quantification, third party risk, and the coverage questions AI raises.',
  },
  {
    title: 'Students & workforce',
    description:
      'Curricula, cyber exercises, competitions, and funded research placements that put students on real operational problems and prepare them for cybersecurity jobs.',
  },
  {
    title: 'Open research output',
    description:
      'We release benchmarks, datasets, evaluation harnesses, and agent tools publicly so others can reproduce, contest, and build on our results.',
  },
];

const teamGroups = [
  { label: 'Graduate students', members: [{ name: 'Hakan T. Otal', role: 'Lab manager' }] },
  { label: 'Resident researchers', members: [{ name: 'Brianna Bace' }] },
  {
    label: 'Undergraduate students',
    members: [
      { name: 'Shayaan Khaliq' },
      { name: 'Tyler H. Merves' },
      { name: 'Joseph M. Escobar' },
      { name: 'Michael H. Conaway' },
      { name: 'Ahmet Salik' },
      { name: 'Nicholas Spencer' },
    ],
  },
  {
    label: 'Non-resident researchers',
    members: [{ name: 'C. Cagri Akgunduz' }, { name: 'Thora Knight' }, { name: 'Divij Jain' }],
  },
];

const externalLink = { target: '_blank', rel: 'noopener noreferrer' };
---

<Layout metadata={metadata}>
  <!-- Hero ******************* -->
  <section class="not-prose relative">
    <div class="mx-auto max-w-6xl px-4 pb-12 pt-16 sm:px-6 md:px-8 md:pb-16 md:pt-24">
      <p class="text-sm font-medium text-primary">University at Albany, SUNY &middot; Department of Cybersecurity</p>
      <h1
        class="mt-5 max-w-4xl text-[2.25rem] font-semibold leading-[1.1] tracking-[-0.025em] text-heading sm:text-5xl md:text-[3.5rem] md:leading-[1.05] md:tracking-[-0.03em]"
      >
        <span class="text-accent">T</span>ransdisciplinary <span class="text-accent">A</span>pproaches to <span
          class="text-accent">T</span
        >hreat <span class="text-accent">A</span>nalysis and <span class="text-accent">R</span>esilience Laboratory
      </h1>

      <div class="mt-12 grid gap-12 border-t border-hairline pt-8 md:mt-16 md:grid-cols-12 md:gap-8">
        <div class="md:col-span-6">
          <p class="text-xl font-medium leading-7 text-heading">Quantifying cyber risk and securing AI</p>
          <p class="mt-3 max-w-xl text-lg leading-relaxed text-muted">
            We study cyber risk and insurance, the security and safety of AI systems, and the protection of critical
            infrastructure.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a class="btn-primary w-full sm:w-auto" href="#research">Explore our research</a>
            <a class="btn w-full sm:w-auto" href="#contact">Work with us</a>
          </div>
        </div>

        <nav class="md:col-span-5 md:col-start-8" aria-label="Research areas">
          <p class="text-sm font-medium leading-7 text-muted">Research areas</p>
          <ol class="mt-3 border-b border-hairline">
            {
              research.map((item) => (
                <li class="border-t border-hairline">
                  <a
                    class="group flex items-baseline gap-4 py-3 text-[0.9375rem] text-default transition-colors duration-150 hover:text-primary"
                    href={`#${item.anchor}`}
                  >
                    <span class="w-5 shrink-0 text-sm tabular-nums text-muted">{item.number}</span>
                    <span class="group-hover:underline group-hover:underline-offset-4">{item.title}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </div>

      <!-- <div class="mt-14 border-t border-slate-200 pt-10">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted">Part of</p>
        <div class="mt-6 flex justify-center">
          <a href="https://www.albany.edu/cehc" target="_blank" rel="noopener noreferrer">
            <Image
              class="h-32 w-auto sm:h-40 lg:h-44"
              src="~/assets/images/cehc.png"
              alt="College of Emergency Preparedness, Homeland Security and Cybersecurity, University at Albany, State University of New York"
              width={560}
              height={350}
              loading="eager"
            />
          </a>
        </div>
      </div> -->
    </div>
  </section>

  <!-- Mission: four principles in a row ******************* -->
  <Section
    id="mission"
    label="Mission"
    title="Making cyber and AI risk measurable and manageable"
    intro="We combine risk analysis, economics, engineering, and policy to answer questions no single discipline can settle on its own."
    rule
  >
    <div class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        mission.map((item) => (
          <div class="border-t border-hairline pt-5">
            <h3 class="text-lg font-medium leading-snug text-heading lg:min-h-[3.25rem]">{item.title}</h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{item.description}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Research: six numbered tiles on a muted band ******************* -->
  <Section
    id="research"
    title="Research focus areas"
    intro="The lab's current and past work falls into six areas, and most projects touch more than one."
    tone="muted"
    header="split"
  >
    <ol class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        research.map((item) => (
          <li id={item.anchor} class="scroll-mt-24 rounded-lg border border-hairline bg-white p-6 md:p-8">
            <span class="text-sm font-medium tabular-nums text-primary">{item.number}</span>
            <h3 class="mt-4 text-xl font-semibold leading-snug tracking-[-0.01em] text-heading">{item.title}</h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{item.description}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- Research Sponsors: logo wall ******************* -->
  <Section
    id="sponsors"
    title="Research sponsors"
    intro="These agencies and organizations have supported the lab's research."
    header="split"
  >
    <ul class="grid grid-cols-2 gap-x-8 gap-y-12 sm:grid-cols-3 lg:grid-cols-5">
      {
        sponsors.map((sponsor) => (
          <li class="flex flex-col items-center text-center">
            <div class="flex h-14 w-full items-center justify-center">
              <img class="max-h-14 max-w-[9rem] object-contain" src={sponsor.image} alt="" loading="lazy" />
            </div>
            <p class="mt-4 max-w-[12rem] text-[0.8125rem] leading-snug text-muted">{sponsor.name}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- Flagship Initiatives: two halves split by a rule ******************* -->
  <Section
    id="initiatives"
    title="Multi-institutional initiatives"
    intro="Beyond individual projects, the lab leads larger efforts that bring together universities, government, and industry."
    rule
  >
    <div class="grid gap-12 md:grid-cols-2 md:gap-0 md:divide-x md:divide-hairline">
      {
        initiatives.map((item, i) => (
          <article class:list={['flex flex-col', i === 0 ? 'md:pr-12' : 'md:pl-12']}>
            <div class="flex h-14 items-center">
              <img
                class:list={['max-w-[12rem] object-contain', item.logoClass]}
                src={item.image}
                alt={`${item.name} logo`}
                loading="lazy"
              />
            </div>
            <p class="mt-6 text-sm font-medium text-primary">{item.name}</p>
            <h3 class="mt-2 text-2xl font-semibold leading-snug tracking-[-0.01em] text-heading">{item.title}</h3>
            <p class="mt-4 text-base leading-relaxed text-muted">{item.description}</p>
            <a class="link-arrow mt-auto pt-8" href={item.href} {...externalLink}>
              {item.label}
              <span aria-hidden="true">↗</span>
            </a>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- Impact: navy band ******************* -->
  <Section id="impact" label="Impact" title="Who our research serves" tone="dark">
    <dl class="grid gap-x-8 gap-y-10 sm:grid-cols-2">
      {
        impact.map((item) => (
          <div class="border-t border-white/15 pt-6">
            <dt class="text-xl font-semibold text-white">{item.title}</dt>
            <dd class="mt-3 max-w-md text-base leading-relaxed text-white/70">{item.description}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <!-- Stats ******************* -->
  <!-- <Stats
    title="By the numbers"
    stats={[
      { title: 'Peer-reviewed publications', amount: '40+', icon: 'tabler:file-text' },
      { title: 'In grants & contracts', amount: '$5M+', icon: 'tabler:coin' },
      { title: 'Citations', amount: '1,000+', icon: 'tabler:quote' },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Stats> -->

  <!-- Team: director feature, then four group columns ******************* -->
  <Section id="team" title="Team">
    <div class="grid gap-8 md:grid-cols-12">
      <div class="w-40 md:col-span-3 md:w-full">
        <Image
          class="aspect-square w-full rounded-lg object-cover"
          src="~/assets/images/tatar.jpg"
          alt="Portrait of Dr. Unal Tatar"
          width={400}
          height={400}
          loading="lazy"
        />
      </div>
      <div class="md:col-span-8 md:col-start-4">
        <p class="text-sm font-medium text-primary">Director</p>
        <h3 class="mt-2 text-2xl font-semibold tracking-[-0.01em] text-heading">Dr. Unal Tatar</h3>
        <p class="mt-4 text-base leading-relaxed text-default">
          Associate Professor in the Department of Cybersecurity at the University at Albany. His work combines
          cybersecurity, AI, risk analysis, and insurance. He is the lead principal investigator of the DoD funded VICOR
          institute and leads the NSF funded planning phase of the
          <a class="text-link" href="https://catis.org" {...externalLink}>CATIS Center</a>
          for cyber and terrorism insurance research. He is also a co-principal investigator of
          <a class="text-link" href="https://www.albany.edu/cehc/crest" {...externalLink}>CREST</a>, UAlbany's NIST
          funded Cybersecurity Incident Response Studio. He has secured over $5 million in grants and contracts in
          cybersecurity and AI, and the National Association of Insurance Commissioners named him a Research Fellow.
          Before joining academia he headed Turkey's national CERT and advised NATO's Centre of Excellence for Defence
          Against Terrorism.
        </p>
        <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
          <a class="link-arrow" href="https://www.albany.edu/cehc/faculty/unal-tatar" {...externalLink}>
            Faculty profile <span aria-hidden="true">↗</span>
          </a>
          <a class="link-arrow" href="https://scholar.google.com/citations?user=3agv4kcAAAAJ&hl=en" {...externalLink}>
            Google Scholar <span aria-hidden="true">↗</span>
          </a>
          <a class="link-arrow" href="https://www.linkedin.com/in/utatar" {...externalLink}>
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>

    <div class="mt-16 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        teamGroups.map((group) => (
          <div class="border-t border-hairline pt-5">
            <h4 class="text-sm font-medium text-muted">{group.label}</h4>
            <ul class="mt-4 space-y-2">
              {group.members.map((member) => (
                <li class="text-base text-heading">
                  {member.name}
                  {member.role && <span class="block text-sm text-muted">{member.role}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Contact ******************* -->
  <Section id="contact" tone="muted">
    <div class="grid gap-12 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-6">
        <p class="text-sm font-medium text-primary">Contact</p>
        <h2
          class="mt-3 text-3xl font-semibold leading-tight tracking-[-0.02em] text-heading md:text-[2.5rem] md:leading-[1.15]"
        >
          Work with the lab
        </h2>
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-muted">
          We are glad to hear from prospective graduate and undergraduate students, and from collaborators in
          government, industry, and insurance. A short note about what you are working on is the best place to start.
        </p>
        <a class="btn-primary mt-8 inline-flex" href="mailto:utatar@albany.edu">Get in touch</a>
      </div>

      <dl class="border-b border-hairline md:col-span-5 md:col-start-8">
        <div class="border-t border-hairline py-5">
          <dt class="text-sm text-muted">Email</dt>
          <dd class="mt-1 text-lg">
            <a class="text-link" href="mailto:utatar@albany.edu">utatar@albany.edu</a>
          </dd>
        </div>
        <div class="border-t border-hairline py-5">
          <dt class="text-sm text-muted">Lab location</dt>
          <dd class="mt-1 text-base leading-relaxed text-heading">
            ETEC Building, Room 350P<br />
            1220 Washington Avenue<br />
            Albany, NY 12203
          </dd>
        </div>
        <div class="border-t border-hairline py-5">
          <dt class="text-sm text-muted">Code &amp; data</dt>
          <dd class="mt-1 text-base">
            <a class="text-link" href="https://github.com/TATAR-LAB" {...externalLink}>github.com/TATAR-LAB</a>
          </dd>
        </div>
      </dl>
    </div>
  </Section>
</Layout>
