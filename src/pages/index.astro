---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import Stats from '~/components/widgets/Stats.astro';
import Image from '~/components/common/Image.astro';

const metadata = {
  title: 'TATAR Lab',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Logo ******************* -->
  <div class="flex flex-col sm:flex-row items-center justify-center gap-x-4 gap-y-4 pt-5">
    <Image
      class="w-full"
      widths={[400, 768, 1024, 2040]}
      sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px"
      loading="eager"
      width={350}
      src="~/assets/images/cehc.png"
      alt="Ualbany Logo"
    />
    <Image
      class="w-full"
      widths={[400, 768, 1024, 2040]}
      sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px"
      loading="eager"
      width={250}
      src="~/assets/images/logo.png"
      alt="Lab Logo"
    />
  </div>

  <!-- Hero Widget ******************* -->
  <Hero>
    <!-- image={{ src: '~/assets/images/lab2.jpeg', alt: 'Lab' }}> -->
    <!-- Animated Gradient Title -->
    <Fragment slot="title">
      <h1
        class="text-5xl py-3 font-extrabold bg-gradient-to-r from-gray-100 via-blue-500 to-gray-900 bg-clip-text text-transparent"
      >
        TATAR LAB
      </h1>
    </Fragment>

    <!-- Bold Subtitle -->
    <Fragment slot="subtitle">
      <p class="text-xl py-5 font-bold text-white">
        The TATAR Laboratory, led by Dr. Tatar, is at the forefront of advancing cybersecurity and AI risk and safety.
      </p>
    </Fragment>

    <!-- Bold Content -->
    <Fragment slot="content">
      <p class="text-md py-5 font-bold text-gray-600">
        University at Albany SUNY, ETEC Room 350P
        <br />1220 Washington Avenue, Albany, NY 12226
      </p>
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->
  <!-- <Note content="NOTE" /> -->

  <Content
    isReversed
    tagline="Our"
    title="Mission & Focus"
    items={[
      {
        title: 'AI Security & Risk Models',
        description:
          'Analyzing and evaluating the risks of advanced AI models, alongside their implications for both defensive and offensive security.',
      },
      {
        title: 'Cyber Economics & Insurance',
        description:
          'Investigating the economics of cybersecurity, including cyber risk quantification and the challenges of cyber insurance.',
      },
      {
        title: 'Critical Infrastructure',
        description:
          'Developing models to capture and mitigate the cascading impacts of cyberattacks across interconnected systems and national security.',
      },
    ]}
    image={{
      src: '~/assets/images/img2.jpg',
      alt: 'Colorful Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Advancing Security Through Research</h3>
      We integrate perspectives from risk analysis, economics, engineering, and policy to solve complex cybersecurity challenges and build resilient digital environments.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    tagline="Our"
    title="Director"
    items={[
      {
        title: 'Dr. Unal Tatar',
        description: 'Dr. Unal Tatar is an Associate Professor in the Department of Cybersecurity at UAlbany. With over two decades of experience spanning government, academia, and international initiatives, his research bridges the technical, managerial, and policy aspects of cybersecurity.',
        callToAction: {
          target: '_blank',
          text: 'Website',
          href: 'https://www.albany.edu/cehc/faculty/unal-tatar',
        },
      },
    ]}
    image={{
      src: '~/assets/images/tatar.jpg',
      alt: 'Photo of Dr. Tatar',
    }}
  >
    <!-- <Fragment slot="content">Ensure your online presence truly represents you.</Fragment> -->
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Our Research Areas ******************* -->

  <Features
    tagline="What We Do"
    title="Research Focus Areas"
    items={[
      {
        title: 'AI Security & Validation',
        description:
          'Benchmarking and assessing the capabilities and vulnerabilities of state-of-the-art LLMs and AI systems in cybersecurity contexts.',
        icon: 'tabler:brain',
      },
      {
        title: 'Cyber Insurance & Risk',
        description:
          'Quantifying cyber risks and studying the structure, challenges, and economics of the cyber insurance market.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Critical Infrastructure',
        description:
          'Modeling risk propagation and cascading impacts of cyber incidents across essential systems and infrastructure.',
        icon: 'tabler:building-factory',
      },
      {
        title: 'Economics of Cybersecurity',
        description:
          'Evaluating security investments, incentives, and the economic forces that shape organizational risk management.',
        icon: 'tabler:chart-bar',
      },
      {
        title: 'Cybersecurity Decision Making',
        description:
          'Applying risk analysis, operations research, and policy analysis to improve strategic cyber defense planning.',
        icon: 'tabler:bulb',
      },
      {
        title: 'Capacity Building',
        description:
          'Developing innovative curricula, cyber exercises, and workforce programs to train the next generation of cyber professionals.',
        icon: 'tabler:school',
      },
    ]}
  />

  <!-- Real-World Impact ******************* -->

  <Steps
    title="Driving Real-World Impact"
    image={{
      src: '~/assets/images/img1.jpeg',
      alt: 'Steps image',
    }}
    items={[
      {
        title: 'Government & Defense Collaboration',
        description: 'Partnering with federal agencies, the DoD, and international organizations to address complex cybersecurity threats and design national-level cyber exercises.',
        icon: 'tabler:shield-lock',
      },
      {
        title: 'Industry & Insurance Partnerships',
        description:
          'Collaborating with insurance industry leaders and organizations to develop robust models for cyber risk quantification and liability assessment.',
        icon: 'tabler:building-bank',
      },
      {
        title: 'Education & Workforce',
        description:
          'Transforming cybersecurity education at the university level and fostering a pipeline of talented students equipped to tackle modern threats.',
        icon: 'tabler:users',
      },
    ]}
  />

  <!-- Lab Stats ******************* -->

  <Stats
    title="Lab Stats"
    stats={[
      { title: 'Papers Published', amount: '40+' },
      { title: 'Grant Funding', amount: '$4M+' },
      { title: 'Graduate Students', amount: '8' },
      { title: 'Undergraduate Students', amount: '5+' },
    ]}
  />

  <!-- Background styling if needed -->
  <Fragment slot="bg">
    <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
  </Fragment>
</Layout>
