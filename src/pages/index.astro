---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';

import Stats from '~/components/widgets/Stats.astro';
import Image from '~/components/common/Image.astro';
import viceroyLogo from '~/assets/images/viceroy-logo.webp';
import catisLogo from '~/assets/images/catis-logo.webp';
import nsfLogo from '~/assets/images/sponsors/nsf.webp';
import dodLogo from '~/assets/images/sponsors/dod.webp';
import afrlLogo from '~/assets/images/sponsors/afrl.webp';
import onrLogo from '~/assets/images/sponsors/onr.webp';
import nistLogo from '~/assets/images/sponsors/nist.webp';
import nsaLogo from '~/assets/images/sponsors/nsa.webp';
import natoLogo from '~/assets/images/sponsors/nato.webp';
import griffissLogo from '~/assets/images/sponsors/griffiss.webp';
import gfceLogo from '~/assets/images/sponsors/gfce.webp';
import soaLogo from '~/assets/images/sponsors/soa.webp';

const metadata = {
  title: 'TATAR Lab · Cyber Risk, AI Security, and Critical Infrastructure',
  ignoreTitleTemplate: true,
};

// Shared card treatment: white panel, hairline border, navy icon chip, left aligned.
const cardClasses = {
  items: {
    panel:
      'flex-col h-full max-w-none rounded-xl border border-slate-200 bg-white p-6 text-center shadow-sm sm:text-left',
    icon: 'w-11 h-11 p-2.5 mb-4 mr-0 rtl:ml-0 rounded-lg bg-primary/5 text-primary ring-1 ring-primary/10',
    title: 'text-lg md:text-lg font-bold leading-snug tracking-tight sm:min-h-[3.25rem]',
    description: 'mt-2 text-[0.95rem] leading-relaxed text-muted',
  },
};

const initiatives = [
  {
    name: 'VICOR',
    title: 'Virtual Institute of Cyber Operations and Research',
    description:
      'A multi-university cyber institute led by the University at Albany and funded by the Department of Defense. VICOR builds the operational skills of future cyber leaders through applied training, competitions, internships, and research placements.',
    image: viceroyLogo.src,
    href: 'https://cyberresearchgroup.org/',
    label: 'cyberresearchgroup.org',
  },
  {
    name: 'CATIS',
    title: 'Cyber and Terrorism Insurance Studies',
    description:
      'A cyber and terrorism insurance research center in its NSF funded planning phase, jointly led by the University at Albany and the University of Michigan. The planning grant, from the NSF Industry-University Cooperative Research Centers program, funds the work of bringing academic and industry partners together around catastrophic cyber and terrorism risk, insurance, and emerging technologies.',
    image: catisLogo.src,
    href: 'https://catis.org',
    label: 'catis.org',
  },
];

const sponsors = [
  { name: 'National Science Foundation', image: nsfLogo.src },
  { name: 'Department of Defense', image: dodLogo.src },
  { name: 'Air Force Research Laboratory', image: afrlLogo.src },
  { name: 'Office of Naval Research', image: onrLogo.src },
  { name: 'National Institute of Standards and Technology', image: nistLogo.src },
  { name: 'National Security Agency', image: nsaLogo.src },
  { name: 'NATO Science for Peace and Security Programme', image: natoLogo.src },
  { name: 'Griffiss Institute', image: griffissLogo.src },
  { name: 'Global Forum on Cyber Expertise', image: gfceLogo.src },
  { name: 'Society of Actuaries', image: soaLogo.src },
];
---

<Layout metadata={metadata}>
  <!-- Hero ******************* -->
  <Hero>
    <Fragment slot="title">
      <span class="block text-3xl leading-tight text-slate-900 sm:text-4xl md:text-5xl">
        <span class="text-accent">T</span>ransdisciplinary <span class="text-accent">A</span>pproaches to <span class="text-accent">T</span>hreat <span class="text-accent">A</span>nalysis and <span class="text-accent">R</span>esilience
      </span>
      <span class="mt-4 block text-2xl font-bold tracking-tight text-primary sm:text-3xl md:text-4xl">TATAR Lab</span>
      <span class="mt-3 block text-lg font-semibold tracking-normal text-slate-700 sm:text-xl md:text-2xl">
        Quantifying cyber risk and securing AI
      </span>
    </Fragment>

    <Fragment slot="subtitle">
      <p class="mx-auto max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">
        A research lab at the University at Albany, SUNY, working on cyber risk and insurance, the security and safety
        of AI systems, and the protection of critical infrastructure.
      </p>
    </Fragment>

    <Fragment slot="content">
      <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a class="btn-primary w-full sm:w-auto" href="#research">Explore our research</a>
        <a class="btn w-full sm:w-auto" href="#contact">Work with us</a>
      </div>

      <!-- <div class="mt-14 border-t border-slate-200 pt-10">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted">Part of</p>
        <div class="mt-6 flex justify-center">
          <a href="https://www.albany.edu/cehc" target="_blank" rel="noopener noreferrer">
            <Image
              class="h-32 w-auto sm:h-40 lg:h-44"
              src="~/assets/images/cehc.png"
              alt="College of Emergency Preparedness, Homeland Security and Cybersecurity, University at Albany, State University of New York"
              width={560}
              height={350}
              loading="eager"
            />
          </a>
        </div>
      </div> -->
    </Fragment>
  </Hero>

  <!-- Mission ******************* -->
  <Features
    id="mission"
    tagline="Our mission"
    title="Making cyber and AI risk measurable and manageable"
    subtitle="We combine risk analysis, economics, engineering, and policy to answer questions no single discipline can settle on its own."
    columns={2}
    classes={cardClasses}
    items={[
      {
        title: 'Quantify risk with evidence',
        description:
          'We build benchmarks, datasets, and evaluation frameworks that turn qualitative judgments about AI and cyber risk into measurements that can be compared and audited.',
        icon: 'tabler:ruler-measure',
      },
      {
        title: 'Model systemic and cascading risk',
        description:
          'Risk rarely stays where it starts. We trace how it spreads across interconnected systems, insurance portfolios, and critical infrastructure.',
        icon: 'tabler:affiliate',
      },
      {
        title: 'Translate research into decisions',
        description:
          'Our work is aimed at the people who act on it: security teams, insurers, regulators, and boards. We put findings in the language each of them uses.',
        icon: 'tabler:target-arrow',
      },
      {
        title: 'Develop the cybersecurity workforce',
        description:
          'Managing these risks takes skilled people. Through VICOR and lab research, students gain hands-on experience in cyber operations, AI security, and risk analysis that prepares them for careers in the field.',
        icon: 'tabler:school',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Features>

  <!-- Research Focus Areas ******************* -->
  <Features
    id="research"
    tagline="What we work on"
    title="Research focus areas"
    subtitle="Six threads run through the lab's current and past work. They overlap by design."
    columns={3}
    classes={cardClasses}
    items={[
      {
        title: 'Frontier AI & Agentic Security',
        description:
          'AI agents are starting to do real offensive and defensive security work. Red teaming frontier models and agents on realistic tasks shows how far they get and what closes the gap between a low-cost model and a frontier one.',
        icon: 'tabler:robot',
      },
      {
        title: 'LLM Risk, Safety & Evaluation',
        description:
          'Language models are hard to compare on security without a common yardstick. Adversarial evaluations and scoring built on established taxonomies provide that yardstick and trace how risk in a base model carries into everything derived from it.',
        icon: 'tabler:shield-search',
      },
      {
        title: 'Cyber & AI Insurance',
        description:
          'Cyber risk is still hard to price. This work examines how catastrophic and systemic exposures behave and where policies written before AI leave coverage ambiguous.',
        icon: 'tabler:umbrella',
      },
      {
        title: 'Economics of Cybersecurity',
        description:
          'Security budgets are set under uncertainty, and the incentives rarely point where the risk is. We apply risk analysis, operations research, and economics to prioritize security investment and risk mitigation.',
        icon: 'tabler:chart-arrows',
      },
      {
        title: 'Critical Infrastructure',
        description:
          'Attacks on infrastructure do not stop at the system they hit. We model how disruptions cascade across healthcare, space, maritime, and other interconnected sectors, and study the new risks AI brings to industrial control systems.',
        icon: 'tabler:building-broadcast-tower',
      },
      {
        title: 'AI Governance, Oversight & Policy',
        description:
          'Governing AI starts with a reliable record of how it fails in the world. We build that record, evaluate the tooling meant to govern AI, study how people keep effective oversight of autonomous systems, and work on the policy and national security questions that follow.',
        icon: 'tabler:scale',
      },
    ]}
  />

  <!-- Research Sponsors ******************* -->
  <section id="sponsors" class="not-prose relative scroll-mt-[72px]">
    <div class="relative mx-auto max-w-5xl px-4 pb-12 text-default md:px-6 md:pb-16 lg:pb-20">
      <div class="border-t border-slate-200 pt-12 md:pt-16">
        <div class="mb-8 text-center md:mx-auto md:mb-12 md:max-w-3xl">
          <p class="text-base font-bold uppercase tracking-wide text-secondary">Research sponsors</p>
          <h2 class="font-heading text-3xl font-bold leading-tight tracking-tighter md:text-4xl">Supported by</h2>
          <p class="mt-4 text-xl text-muted">Our research has been supported by these agencies and organizations.</p>
        </div>

        <div class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-5">
          {
            sponsors.map((sponsor) => (
              <div class="flex flex-col items-center text-center">
                <div class="flex h-16 w-full items-center justify-center">
                  <img
                    class="max-h-16 max-w-full object-contain sm:max-w-[10rem]"
                    src={sponsor.image}
                    alt=""
                    loading="lazy"
                  />
                </div>
                <p class="mt-3 text-sm font-medium text-muted">{sponsor.name}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Flagship Initiatives ******************* -->
  <section id="initiatives" class="not-prose relative scroll-mt-[72px]">
    <div class="absolute inset-0 -z-[1] bg-slate-50 dark:bg-transparent" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-5xl px-4 py-12 text-default md:px-6 md:py-16 lg:py-20">
      <div class="mb-8 text-center md:mx-auto md:mb-12 md:max-w-3xl">
        <p class="text-base font-bold uppercase tracking-wide text-secondary">At scale</p>
        <h2 class="font-heading text-3xl font-bold leading-tight tracking-tighter md:text-4xl">Multi-institutional initiatives</h2>
        <p class="mt-4 text-xl text-muted">
          Beyond individual projects, the lab leads larger efforts that bring together universities, government, and
          industry.
        </p>
      </div>

      <div class="grid gap-8 sm:grid-cols-2">
        {
          initiatives.map((item) => (
            <div class="flex h-full flex-col rounded-xl border border-slate-200 bg-white p-7 text-center shadow-sm sm:text-left">
              <div class="mx-auto mb-4 p-4">
                <img
                  class="mx-auto h-auto max-h-14 w-auto object-contain"
                  src={item.image}
                  alt={`${item.name} logo`}
                  loading="lazy"
                />
              </div>
              <p class="text-xs font-bold uppercase tracking-[0.16em] text-secondary">{item.name}</p>
              <h3 class="mt-1 text-xl sm:min-h-[3.5rem] font-bold leading-snug tracking-tight">{item.title}</h3>
              <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">{item.description}</p>
              <div class="mt-auto flex flex-wrap items-center justify-center gap-x-4 gap-y-2 pt-6 sm:justify-start">
                <a class="btn-primary px-5 py-2.5 text-sm" href={item.href} target="_blank" rel="noopener noreferrer">
                  Read more
                </a>
                <span class="text-sm text-muted">{item.label}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Impact ******************* -->
  <Steps
    tagline="Impact"
    title="Who our research serves"
    items={[
      {
        title: 'Government & defense',
        description:
          'Research supported by and conducted with NSF, DoD, AFRL, ONR, NSA, NIST, and NATO.',
        icon: 'tabler:building-castle',
      },
      {
        title: 'Industry & insurance',
        description:
          'Society of Actuaries research projects and an NAIC research fellowship, alongside work with insurers and risk practitioners on cyber risk quantification, third party risk, and the coverage questions raised by AI.',
        icon: 'tabler:briefcase',
      },
      {
        title: 'Students & workforce',
        description:
          'Curricula, cyber exercises, competitions, and funded research placements that move students into real operational problems and into the cybersecurity workforce.',
        icon: 'tabler:users',
      },
      {
        title: 'Open research output',
        description:
          'Benchmarks, datasets, evaluation harnesses, and agent tooling released publicly so results can be reproduced, contested, and built on.',
        icon: 'tabler:brand-github',
      },
    ]}
  />

  <!-- Stats ******************* -->
  <!-- <Stats
    title="By the numbers"
    stats={[
      { title: 'Peer-reviewed publications', amount: '40+', icon: 'tabler:file-text' },
      { title: 'In grants & contracts', amount: '$5M+', icon: 'tabler:coin' },
      { title: 'Citations', amount: '1,000+', icon: 'tabler:quote' },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Stats> -->

  <!-- Team ******************* -->
  <section id="team" class="not-prose relative scroll-mt-[72px]">
    <div class="absolute inset-0 -z-[1] bg-slate-50 dark:bg-transparent" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-5xl px-4 py-12 text-default md:px-6 md:py-16 lg:py-20">
      <div class="mb-8 text-center md:mx-auto md:mb-12 md:max-w-3xl">
        <p class="text-base font-bold uppercase tracking-wide text-secondary">Who we are</p>
        <h2 class="font-heading text-3xl font-bold leading-tight tracking-tighter md:text-4xl">Team</h2>
      </div>

      <!-- Director -->
      <div
        class="mb-8 flex flex-col items-center gap-6 rounded-xl border border-slate-200 bg-white p-6 text-center shadow-sm sm:flex-row sm:items-start sm:gap-8 sm:p-8 sm:text-left"
      >
        <Image
          class="h-36 w-36 shrink-0 rounded-full object-cover"
          src="~/assets/images/tatar.jpg"
          alt="Portrait of Dr. Unal Tatar"
          width={144}
          height={144}
          layout="fixed"
          loading="lazy"
        />
        <div>
          <p class="text-sm font-bold uppercase tracking-wide text-secondary">Director</p>
          <h3 class="mb-3 mt-1 text-2xl font-bold tracking-tight dark:text-white">Dr. Unal Tatar</h3>
          <p class="text-base leading-relaxed text-muted">
            Associate Professor in the Department of Cybersecurity at the University at Albany, working at the intersection
            of cybersecurity, AI, risk analysis, and insurance. He is the lead principal investigator of the DoD funded
            VICOR institute, leads the NSF funded planning phase of the
            <a class="font-semibold text-primary hover:underline" href="https://catis.org" target="_blank" rel="noopener noreferrer">CATIS Center</a>
            for cyber and terrorism insurance research, and is a co-principal investigator of
            <a class="font-semibold text-primary hover:underline" href="https://www.albany.edu/cehc/crest" target="_blank" rel="noopener noreferrer">CREST</a>,
            UAlbany&rsquo;s NIST funded Cybersecurity Incident Response Studio.
            He has secured over $5 million in grants and contracts in cybersecurity and AI and was named a Research Fellow by
            the National Association of Insurance Commissioners. Before joining academia he headed Turkey&rsquo;s national
            CERT and advised NATO&rsquo;s Centre of Excellence for Defence Against Terrorism.
          </p>
          <div class="mt-4 flex flex-wrap gap-x-6 text-sm font-semibold text-primary">
            <a
              class="inline-block py-2.5 hover:underline"
              href="https://www.albany.edu/cehc/faculty/unal-tatar"
              target="_blank"
              rel="noopener noreferrer"
            >
              Faculty profile
            </a>
            <a
              class="inline-block py-2.5 hover:underline"
              href="https://scholar.google.com/citations?user=3agv4kcAAAAJ&hl=en"
              target="_blank"
              rel="noopener noreferrer"
            >
              Google Scholar
            </a>
            <a
              class="inline-block py-2.5 hover:underline"
              href="https://www.linkedin.com/in/utatar"
              target="_blank"
              rel="noopener noreferrer"
            >
              LinkedIn
            </a>
          </div>
        </div>
      </div>

      <!-- Team Members -->
      <div class="grid gap-8 sm:grid-cols-2">
        <!-- Graduate Students -->
        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <h4 class="mb-4 text-sm font-bold uppercase tracking-wide text-secondary">Graduate Students</h4>
          <ul class="space-y-3">
            <li class="text-lg font-semibold text-default">
              Hakan T. Otal <span class="font-normal text-muted">(Lab Manager)</span>
            </li>
          </ul>
        </div>

        <!-- Resident Researchers -->
        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <h4 class="mb-4 text-sm font-bold uppercase tracking-wide text-secondary">Resident Researchers</h4>
          <ul class="space-y-3">
            <li class="text-lg font-semibold text-default">Brianna Bace</li>
          </ul>
        </div>

        <!-- Undergraduate Students -->
        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <h4 class="mb-4 text-sm font-bold uppercase tracking-wide text-secondary">Undergraduate Students</h4>
          <ul class="space-y-3">
            <li class="text-lg font-semibold text-default">Shayaan Khaliq</li>
            <li class="text-lg font-semibold text-default">Tyler H. Merves</li>
            <li class="text-lg font-semibold text-default">Joseph M. Escobar</li>
            <li class="text-lg font-semibold text-default">Michael H. Conaway</li>
            <li class="text-lg font-semibold text-default">Ahmet Salik</li>
            <li class="text-lg font-semibold text-default">Nicholas Spencer</li>
          </ul>
        </div>

        <!-- Non-Resident Researchers -->
        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <h4 class="mb-4 text-sm font-bold uppercase tracking-wide text-secondary">Non-Resident Researchers</h4>
          <ul class="space-y-3">
            <li class="text-lg font-semibold text-default">C. Cagri Akgunduz</li>
            <li class="text-lg font-semibold text-default">Thora Knight</li>
            <li class="text-lg font-semibold text-default">Divij Jain</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact ******************* -->
  <section id="contact" class="not-prose relative scroll-mt-[72px]">
    <div class="absolute inset-0 -z-[1] bg-slate-50 dark:bg-transparent" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-5xl px-6 py-12 text-default md:px-8 md:py-16 lg:py-20">
      <div class="grid items-center gap-10 md:grid-cols-2 md:gap-14">
        <div>
          <p class="text-base font-bold uppercase tracking-wide text-secondary">Contact</p>
          <h2 class="mt-2 font-heading text-3xl font-bold leading-tight tracking-tighter md:text-4xl">
            Work with the lab
          </h2>
          <p class="mt-4 text-lg text-muted">
            We are glad to hear from prospective graduate and undergraduate students, and from collaborators in
            government, industry, and insurance. A short note about what you are working on is the best place to start.
          </p>
          <a class="btn-primary mt-8 inline-flex" href="mailto:utatar@albany.edu">Get in touch</a>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-7 shadow-sm">
          <dl class="space-y-6">
            <div>
              <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-muted">Email</dt>
              <dd class="mt-1 text-lg">
                <a class="inline-block py-1 font-semibold text-primary hover:underline" href="mailto:utatar@albany.edu">
                  utatar@albany.edu
                </a>
              </dd>
            </div>
            <div>
              <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-muted">Lab location</dt>
              <dd class="mt-1 text-base leading-relaxed">
                ETEC Building, Room 350P<br />
                1220 Washington Avenue<br />
                Albany, NY 12203
              </dd>
            </div>
            <div>
              <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-muted">Code &amp; data</dt>
              <dd class="mt-1 text-base">
                <a
                  class="inline-block py-1 font-semibold text-primary hover:underline"
                  href="https://github.com/TATAR-LAB"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  github.com/TATAR-LAB
                </a>
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>
</Layout>
